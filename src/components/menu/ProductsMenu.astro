---
import CoffeMenu from "./CoffeMenu.astro";
import FoodMenu from "./FoodMenu.astro";


---
<section class="bg-coffee-800 py-10 -mt-20">
    <div 
        class="max-w-7xl mx-auto bg-menu-image bg-no-repeat bg-contain bg-position-[center_80px] pt-37.5 lg:pt-62.5 pb-40"
    >
        <h3 class="text-white font-black text-center text-xl pb-4 uppercase">
            nuestro delicioso
            <span class="text-4xl block">
                menú
            </span>
        </h3>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-10">
            <CoffeMenu />
            <FoodMenu />
        </div>
    </div>
</section>
